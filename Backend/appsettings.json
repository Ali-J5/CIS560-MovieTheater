{
  "ConnectionStrings": {
    // Default: SQL Server listening locally on TCP port 1433 (works with a local container).
    // Set your database name and real SQL login; the password below is only a placeholder.
    // TrustServerCertificate=True accepts the local development server's certificate.
    "DefaultConnection": "Server=localhost,1433;Database=MovieTheaterDB;User Id=sa;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True;Connect Timeout=5;"
    // Windows LocalDB alternative (LocalDB is not available on macOS):
    // "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=MovieTheaterDB;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;"
    // Windows SQL Express alternative using your Windows account:
    // "DefaultConnection": "Server=.\\SQLEXPRESS;Database=MovieTheaterDB;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;"
    // Other local instance: replace Server with its host,port or Windows host\\instance.
    // For a local password override, use the ConnectionStrings__DefaultConnection environment variable
    // or an untracked appsettings.Development.json file; keep real credentials out of source control.
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
