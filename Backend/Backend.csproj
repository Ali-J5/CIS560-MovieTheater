<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Target the course-required .NET 8 framework and enable null-safety checks. -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- SqlClient is our only database access library; Swagger supplies the browser API explorer. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.8" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>
</Project>
